# Postgres connection string (Neon). Required — there is no local-file fallback.
# Use a separate Neon branch/database per environment (e.g. a personal dev branch
# locally, the production branch on Vercel).
DATABASE_URL=

# Only needed to run the db:resolve-llm / db:verify-llm scripts locally; not read by
# the deployed app itself.
ANTHROPIC_API_KEY=
