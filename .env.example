# Postgres connection strings (Neon). Required — there is no local-file fallback.
# Use a separate Neon branch/database per environment (a personal dev branch locally,
# the production branch on Vercel).
#
# DATABASE_URL: the POOLED connection string (Neon's dashboard usually labels this
# "Pooled connection" or has a "Pooled connection" toggle — hostname often has a
# "-pooler" suffix). Used by the running app (src/lib/db.ts) so serverless
# invocations on Vercel don't exhaust Postgres's connection limit.
DATABASE_URL=

# DIRECT_URL: the UNPOOLED connection string (same host without "-pooler"). Used only
# by the Prisma CLI (migrate/generate) — PgBouncer's transaction-mode pooling doesn't
# reliably support the advisory locks `prisma migrate` needs. Falls back to
# DATABASE_URL if omitted, but grab both from Neon.
DIRECT_URL=

# Only needed to run the db:resolve-llm / db:verify-llm scripts locally; not read by
# the deployed app itself.
ANTHROPIC_API_KEY=
