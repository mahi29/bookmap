// BookMap data model. See CLAUDE.md for the ubiquitous language.
// Postgres (Neon) for both dev and prod — DATABASE_URL points at a separate branch/
// database per environment; see src/lib/db.ts and prisma.config.ts.
//
// Enum-like fields (source, resolutionMethod) stay app-validated Strings rather than
// native Postgres enums, and rawRow stays a JSON string rather than a Json column —
// carried over unchanged from the original SQLite design; no reason to churn them now.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// An account. Readings and Imports are per-user; Books/Authors stay global.
model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String // bcrypt; the sentinel "LOCKED" (any non-bcrypt string) never authenticates
  createdAt    DateTime @default(now())
}

/// A title with one or more Authors.
model Book {
  id        String       @id @default(cuid())
  title     String
  isbn      String? // ISBN or other UID from the source; nullable.
  createdAt DateTime     @default(now())
  authors   BookAuthor[]
  readings  Reading[]
}

/// A person resolved to one or more map countries (all citizenships, ISO alpha-3).
model Author {
  id               String          @id @default(cuid())
  name             String          @unique
  wikidataId       String?
  birthCountryIso3 String? // secondary, for future views; never colors the map
  resolutionMethod String          @default("unresolved") // wikidata | openlibrary | llm | manual | unresolved
  confidence       Float? // 0..1, present for llm/automated resolutions
  reasoning        String? // human-readable justification (esp. for llm)
  needsReview      Boolean         @default(false)
  resolvedAt       DateTime?
  books            BookAuthor[]
  countries        AuthorCountry[]
}

/// A map country attributed to an Author (an author can hold several citizenships).
model AuthorCountry {
  authorId String
  iso3     String // ISO 3166-1 alpha-3 modern map country
  author   Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([authorId, iso3])
}

/// Join between Book and Author (books can be co-authored).
model BookAuthor {
  bookId   String
  authorId String
  book     Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author   Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([bookId, authorId])
}

/// A read event: "user finished Book on date X." Carries the dates for range filtering.
model Reading {
  id          String    @id @default(cuid())
  bookId      String
  book        Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  dateRead    DateTime? // finish date; null = undated (all-time only, excluded from ranges)
  dateStarted DateTime?
  rating      Float?
  source      String // storygraph | goodreads | manual
  importId    String?
  import      Import?   @relation(fields: [importId], references: [id], onDelete: SetNull)
  rawRow      String? // JSON-stringified original source row, for debugging/re-parsing
  createdAt   DateTime  @default(now())
}

/// One CSV import run, tracked for dedup/idempotency.
model Import {
  id         String    @id @default(cuid())
  source     String // storygraph | goodreads
  filename   String
  rowCount   Int
  importedAt DateTime  @default(now())
  readings   Reading[]
}
